#!/usr/bin/python3
import json, os, sys
loc = json.load(open(os.environ["FAKE_LOCAL"]))
if len(sys.argv) != 3 or sys.argv[1] != "ahosts":
    sys.stderr.write("fake getent: unexpected arguments\n"); sys.exit(2)
addrs = loc["resolve"].get(sys.argv[2])
if not addrs:
    sys.exit(2)
for a in addrs:
    print("%-15s STREAM %s" % (a, sys.argv[2]))
