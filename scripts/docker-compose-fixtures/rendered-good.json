{
  "name": "cv2-s5",
  "services": {
    "db": {
      "image": "docker.io/pgvector/pgvector:0.8.2-pg18@sha256:42e7f6b4e1eceb02ff14e3e6bc6108bbe259abbe83879dc1845d0da1ddeb555d",
      "container_name": "cv2-s5-db",
      "restart": "unless-stopped",
      "init": true,
      "shm_size": "268435456",
      "mem_limit": "2147483648",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -q -U postgres -h 127.0.0.1 -d cortex >/dev/null 2>&1"
        ],
        "timeout": "20s",
        "interval": "15s",
        "retries": 20,
        "start_period": "10s"
      },
      "secrets": [
        {
          "source": "cv2-s5-db-superuser"
        },
        {
          "source": "cv2-s5-owner-password"
        },
        {
          "source": "cv2-s5-app-password"
        }
      ],
      "volumes": [
        {
          "type": "volume",
          "source": "cv2-s5-pg-data",
          "target": "/var/lib/postgresql",
          "volume": {}
        },
        {
          "type": "bind",
          "source": "/Users/test/cortex/initdb",
          "target": "/docker-entrypoint-initdb.d",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ],
      "networks": {
        "cv2-s5-net": null
      },
      "cpus": 1,
      "labels": {
        "cortexv2": "dev"
      },
      "command": [
        "postgres",
        "-c",
        "shared_buffers=256MB",
        "-c",
        "effective_cache_size=1GB",
        "-c",
        "max_parallel_workers_per_gather=0"
      ],
      "environment": {
        "POSTGRES_DB": "cortex",
        "POSTGRES_INITDB_ARGS": "--auth-local=peer --auth-host=scram-sha-256 -E UTF8 --locale-provider=builtin --locale=C.UTF-8 --builtin-locale=C.UTF-8 --data-checksums",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/cv2-s5-db-superuser"
      }
    },
    "migrate": {
      "image": "registry.example/cortex-server@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "container_name": "cv2-s5-migrate",
      "command": [
        "migrate"
      ],
      "pull_policy": "never",
      "restart": "no",
      "user": "10001:10001",
      "init": true,
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "536870912",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m,mode=1777"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "secrets": [
        {
          "source": "cv2-s5-owner-password"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/Users/test/cortex/cortex.toml",
          "target": "/etc/cortex/cortex.toml",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ],
      "networks": {
        "cv2-s5-net": null
      },
      "cpus": 1,
      "labels": {
        "cortexv2": "dev",
        "cortexv2.role": "oneshot"
      },
      "environment": {
        "HOME": "/tmp"
      }
    },
    "server": {
      "image": "registry.example/cortex-server@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "container_name": "cv2-s5-server",
      "pull_policy": "never",
      "restart": "unless-stopped",
      "user": "10001:10001",
      "init": true,
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "1073741824",
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=128m,mode=1777",
        "/run/cortex:rw,noexec,nosuid,size=16m,uid=10001,gid=10001,mode=0700"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        },
        "migrate": {
          "condition": "service_completed_successfully",
          "required": true
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8601,
          "published": "8601",
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "source": "cv2-s5-app-password"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/Users/test/cortex/cortex.toml",
          "target": "/etc/cortex/cortex.toml",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "bind",
          "source": "/Users/test/cortex/dump-status",
          "target": "/var/lib/cortex-dumps",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "volume",
          "source": "cv2-s5-state",
          "target": "/var/lib/cortex",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "bash",
          "-c",
          "exec 3<>/dev/tcp/127.0.0.1/8601 && printf 'GET /v2/health/ready HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200 '"
        ],
        "timeout": "10s",
        "interval": "15s",
        "retries": 10,
        "start_period": "20s"
      },
      "networks": {
        "cv2-s5-net": null
      },
      "cpus": 1,
      "labels": {
        "cortexv2": "dev"
      },
      "environment": {
        "HOME": "/tmp"
      }
    }
  },
  "networks": {
    "cv2-s5-net": {
      "name": "cv2-s5-net"
    }
  },
  "volumes": {
    "cv2-s5-pg-data": {
      "name": "cv2-s5-pg-data"
    },
    "cv2-s5-state": {
      "name": "cv2-s5-state"
    }
  },
  "secrets": {
    "cv2-s5-db-superuser": {
      "name": "cv2-s5-db-superuser",
      "file": "/Users/test/cortex/secrets/db-superuser"
    },
    "cv2-s5-owner-password": {
      "name": "cv2-s5-owner-password",
      "file": "/Users/test/cortex/secrets/owner-password"
    },
    "cv2-s5-app-password": {
      "name": "cv2-s5-app-password",
      "file": "/Users/test/cortex/secrets/app-password"
    }
  }
}
