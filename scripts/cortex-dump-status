#!/bin/sh
# cortex-dump-status: how old is the last good dump? (piece 12, backup by dump; bob@helix)
# INTERIM(ponytail): pg_dump shell script and timer, replaced in 0.2.003 by cortex backup on pgBackRest.
#
#   cortex-dump-status --status-dir <dir> [--out <dir>] [--max-age-hours 26] [--verify]
#
# Reads <status-dir>/LAST_GOOD (CORTEX_DUMP_STATUS is the default for --status-dir; the flag wins), which cortex-dump writes as ONE line:
#   {"set":"<name>","utc":"YYYY-MM-DDTHH:MM:SSZ","bytes":<n>,"sha256":"<64 hex>"}
# Prints ONE line and exits 0 when the last good dump is within the limit (default 26 hours); exits 1 when it is older, or
# when the file is missing, empty, unreadable, a symlink, too large (over 4096 bytes), or not exactly that shape. The line
# never repeats the file's own words. --verify also checks the set's SHA256SUMS and that LAST_GOOD names that very file.
# CORTEX_DUMP_NOW (an RFC 3339 UTC time ending in Z) replaces the clock; it exists for the tests.
#
# Exit codes: 0 ok; 1 stale or untrustworthy; 2 bad usage.
set -eu
LC_ALL=C
export LC_ALL

me=cortex-dump-status
nl='
'

die() {
  printf '%s: %s\n' "$me" "$2" >&2
  exit "$1"
}

out="" status="" max=26 verify=0
while [ $# -gt 0 ]; do
  case $1 in
    --out) [ $# -ge 2 ] || die 2 "--out needs a value"; out=$2; shift 2 ;;
    --status-dir) [ $# -ge 2 ] || die 2 "--status-dir needs a value"; status=$2; shift 2 ;;
    --max-age-hours) [ $# -ge 2 ] || die 2 "--max-age-hours needs a value"; max=$2; shift 2 ;;
    --verify) verify=1; shift ;;
    -h | --help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die 2 "unknown argument" ;;
  esac
done
[ -n "$status" ] || status=${CORTEX_DUMP_STATUS:-}
[ -n "$status" ] || die 2 "--status-dir (or CORTEX_DUMP_STATUS) is required"
status=${status%/}
[ -n "$status" ] || die 2 "--status-dir must not be the root directory"
if [ "$verify" -eq 1 ] && [ -z "$out" ]; then die 2 "--verify needs --out (the dump directory that holds the sets)"; fi
if [ -n "$out" ]; then
  out=${out%/}
  [ -n "$out" ] || die 2 "--out must not be the root directory"
fi
case $max in
  '' | . | *[!0-9.]* | *.*.*) die 2 "--max-age-hours must be a number" ;;
esac

# the reason line: fixed words only
bad() { # bad <reason>
  printf 'backup stale: %s\n' "$1"
  exit 1
}

file=$status/LAST_GOOD
if [ -L "$file" ]; then bad "LAST_GOOD is a symbolic link"; fi
if [ ! -e "$file" ]; then bad "no last good dump is recorded"; fi
if [ ! -f "$file" ]; then bad "LAST_GOOD is not a regular file"; fi
if [ ! -r "$file" ]; then bad "LAST_GOOD is unreadable"; fi
size=$(wc -c < "$file") || bad "LAST_GOOD is unreadable"
if [ "$size" -eq 0 ]; then bad "LAST_GOOD is empty"; fi
if [ "$size" -gt 4096 ]; then bad "LAST_GOOD is too large"; fi
content=$(cat "$file") || bad "LAST_GOOD is unreadable"
case $content in
  *"$nl"*) bad "LAST_GOOD is not one line" ;;
esac

# exactly the shape cortex-dump writes; anything else cannot be trusted
re='^\{"set":"[0-9]{8}T[0-9]{6}Z(-[0-9]{2})?","utc":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,6})?Z","bytes":[0-9]+,"sha256":"[0-9a-f]{64}"\}$'
printf '%s\n' "$content" | grep -Eq "$re" || bad "LAST_GOOD is not in the recorded format"

set_name=${content#*\"set\":\"}
set_name=${set_name%%\"*}
utc=${content#*\"utc\":\"}
utc=${utc%%\"*}
recorded_sha=${content#*\"sha256\":\"}
recorded_sha=${recorded_sha%%\"*}

# the clock
now_text=${CORTEX_DUMP_NOW:-}
if [ -n "$now_text" ]; then
  printf '%s\n' "$now_text" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{1,6})?Z$' || die 2 "CORTEX_DUMP_NOW is not an RFC 3339 UTC time"
fi

# one awk program: both times to epoch seconds (days-from-civil), the age, the verdict
verdict=$(awk -v t="$utc" -v n="$now_text" -v max="$max" -v realnow="$(date -u +%s)" '
  function days(y, m, d,   era, yoe, doy, doe, mp) {
    if (m <= 2) y -= 1
    era = int((y >= 0 ? y : y - 399) / 400)
    yoe = y - era * 400
    mp = (m + 9) % 12
    doy = int((153 * mp + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return era * 146097 + doe - 719468
  }
  function valid(s,   a, y, m, d, hh, mi, ss, dim) {
    if (split(s, a, /[-T:Z.]/) < 6) return 0
    y = a[1] + 0; m = a[2] + 0; d = a[3] + 0; hh = a[4] + 0; mi = a[5] + 0; ss = a[6] + 0
    if (m < 1 || m > 12 || d < 1 || hh > 23 || mi > 59 || ss > 59) return 0
    if (m == 2) dim = ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) ? 29 : 28
    else if (m == 4 || m == 6 || m == 9 || m == 11) dim = 30
    else dim = 31
    return d <= dim
  }
  function epoch(s,   a) {
    split(s, a, /[-T:Z.]/)
    return days(a[1] + 0, a[2] + 0, a[3] + 0) * 86400 + a[4] * 3600 + a[5] * 60 + a[6]
  }
  BEGIN {
    if (!valid(t)) { print "invalid"; exit }
    if (n != "" && !valid(n)) { print "badnow"; exit }
    then = epoch(t)
    now = (n == "") ? realnow + 0 : epoch(n)
    age = now - then
    if (age < -300) { print "future"; exit }
    if (age < 0) age = 0
    printf "%s %.1f\n", (age > max * 3600 ? "stale" : "ok"), age / 3600
  }
') || bad "the recorded time cannot be read"

case $verdict in
  future) bad "the recorded time is in the future" ;;
  invalid) bad "the recorded time is not a real date" ;;
  badnow) die 2 "CORTEX_DUMP_NOW is not a real time" ;;
esac
state=${verdict%% *}
hours=${verdict#* }

if [ "$verify" -eq 1 ]; then
  dir=$out/$set_name
  [ -d "$dir" ] || bad "the recorded set is missing"
  [ -f "$dir/SHA256SUMS" ] || bad "checksum: the recorded set has no SHA256SUMS"
  sums=$(sha256sum "$dir/SHA256SUMS") || bad "checksum: SHA256SUMS cannot be read"
  [ "${sums%% *}" = "$recorded_sha" ] || bad "checksum: SHA256SUMS is not the one LAST_GOOD names"
  (cd "$dir" && sha256sum -c SHA256SUMS > /dev/null 2>&1) || bad "checksum: the set does not verify"
fi

if [ "$state" = ok ]; then
  printf 'backup ok: last good dump %s hours old (limit %s)\n' "$hours" "$max"
  exit 0
fi
printf 'backup stale: last good dump %s hours old (limit %s)\n' "$hours" "$max"
exit 1
