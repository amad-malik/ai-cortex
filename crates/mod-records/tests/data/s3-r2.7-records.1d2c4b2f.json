      "string",
      "null"
     ]
    },
    "id": {
     "format": "uuid",
     "type": "string"
    },
    "lineage": {
     "oneOf": [
      {
       "$ref": "#/components/schemas/Lineage"
      },
      {
       "type": "null"
      }
     ]
    },
    "provenance": {
     "enum": [
      "worker_written",
