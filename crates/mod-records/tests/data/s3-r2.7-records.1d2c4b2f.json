    },
    "reply_to": {
     "format": "uuid",
     "type": [
      "string",
      "null"
     ]
    },
    "section": {
     "type": [
      "string",
      "null"
     ]
    },
    "section_revision": {
     "type": [
      "integer",
      "null"
     ]
    },
    "source": {
     "oneOf": [
