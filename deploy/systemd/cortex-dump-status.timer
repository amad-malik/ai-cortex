# Hourly freshness check (piece 12; bob@helix). It runs on its OWN timer, so a dump timer that never fires is still seen (BK-05).
[Unit]
Description=Cortex backup freshness check, hourly

[Timer]
OnCalendar=*-*-* *:17:00 UTC
Persistent=true
Unit=cortex-dump-status.service

[Install]
WantedBy=timers.target
